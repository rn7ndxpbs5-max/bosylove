<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دلوعة أحمد 💖</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #ff4b72;
            --primary-hover: #ff2a55;
            --secondary: #ff85a2;
            --accent: #ffd1dc;
            --bg-gradient: linear-gradient(135deg, #ffe6eb 0%, #ffd3dd 50%, #ffb3c6 100%);
            --glass-bg: rgba(255, 255, 255, 0.92);
            --glass-border: rgba(255, 255, 255, 0.8);
            --text-color: #4a2c35;
            --shadow: 0 8px 32px 0 rgba(255, 75, 114, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', 'Tajawal', sans-serif;
        }

        body {
            background: var(--bg-gradient);
            min-height: 100vh;
            color: var(--text-color);
            position: relative;
            overflow-x: hidden;
        }

        /* القلوب المتحركة */
        .hearts-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }

        .heart-particle {
            position: absolute;
            color: rgba(255, 75, 114, 0.35);
            animation: floatUp 8s infinite linear;
            bottom: -50px;
        }

        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg) scale(0.8); opacity: 1; }
            100% { transform: translateY(-110vh) rotate(360deg) scale(1.2); opacity: 0; }
        }

        /* 1. صفحة الدخول */
        #login-screen {
            position: fixed;
            inset: 0;
            background: var(--bg-gradient);
            z-index: 9999;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-card {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            border: 2px solid var(--glass-border);
            border-radius: 30px;
            padding: 40px 30px;
            width: 100%;
            max-width: 440px;
            text-align: center;
            box-shadow: var(--shadow);
        }

        .love-title {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--primary);
            margin-bottom: 8px;
        }

        .pin-input {
            width: 100%;
            padding: 15px 20px;
            border: 2px solid var(--secondary);
            border-radius: 20px;
            font-size: 1.2rem;
            text-align: center;
            outline: none;
            background: rgba(255, 255, 255, 0.95);
            color: var(--primary);
            font-weight: bold;
            margin-bottom: 15px;
        }

        .login-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            border: none;
            border-radius: 20px;
            color: white;
            font-size: 1.2rem;
            font-weight: bold;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(255, 75, 114, 0.3);
            transition: all 0.3s;
        }

        .login-btn:hover {
            transform: translateY(-2px);
        }

        /* 2. صفحة المفاجأة */
        #surprise-screen {
            display: none;
            position: fixed;
            inset: 0;
            background: var(--bg-gradient);
            z-index: 9998;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .surprise-card {
            background: var(--glass-bg);
            border: 2px solid var(--glass-border);
            border-radius: 35px;
            padding: 40px 30px;
            width: 100%;
            max-width: 650px;
            text-align: center;
            box-shadow: var(--shadow);
        }

        .surprise-text {
            font-size: 1.2rem;
            line-height: 2;
            color: #522d38;
            margin: 20px 0;
            background: rgba(255, 255, 255, 0.7);
            padding: 20px;
            border-radius: 20px;
        }

        /* 3. التطبيق الرئيسي */
        #app-container {
            display: none;
            max-width: 1100px;
            margin: 0 auto;
            padding: 20px;
            position: relative;
            z-index: 1;
        }

        header {
            background: var(--glass-bg);
            border-radius: 25px;
            padding: 18px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--shadow);
        }

        .tabs-nav {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            overflow-x: auto;
        }

        .tab-btn {
            flex: 1;
            min-width: 130px;
            padding: 12px 15px;
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            color: var(--text-color);
            font-weight: bold;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .tab-btn.active {
            background: var(--primary);
            color: white;
        }

        .tab-content {
            display: none;
            background: var(--glass-bg);
            border-radius: 25px;
            padding: 25px;
            border: 1px solid var(--glass-border);
            box-shadow: var(--shadow);
            min-height: 500px;
        }

        .tab-content.active {
            display: block;
        }

        .chat-wrapper {
            display: flex;
            flex-direction: column;
            height: 480px;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .message {
            max-width: 85%;
            padding: 14px 18px;
            border-radius: 20px;
            font-size: 1rem;
            line-height: 1.6;
        }

        .message.bot {
            align-self: flex-start;
            background: white;
            color: var(--text-color);
            border-bottom-right-radius: 4px;
            border: 1px solid #ffd8e1;
        }

        .message.user {
            align-self: flex-end;
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            color: white;
            border-bottom-left-radius: 4px;
        }

        .chat-input-area {
            display: flex;
            gap: 10px;
            padding-top: 15px;
            border-top: 1px solid rgba(255, 75, 114, 0.15);
        }

        .chat-input {
            flex: 1;
            padding: 14px 20px;
            border: 1px solid var(--secondary);
            border-radius: 20px;
            outline: none;
            background: white;
            font-size: 1rem;
        }

        .send-btn {
            background: var(--primary);
            color: white;
            border: none;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.2rem;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .card-box {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 20px;
            border: 1px solid #ffccd5;
        }

        .prayer-item {
            display: flex;
            justify-content: space-between;
            padding: 10px;
            background: #fff5f7;
            border-radius: 12px;
            margin-bottom: 8px;
        }

        .prayer-status {
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.85rem;
            cursor: pointer;
            font-weight: bold;
        }

        .status-done { background: #d4edda; color: #155724; }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-exempt { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>

    <div class="hearts-bg" id="hearts-container"></div>

    <!-- 1. الشاشة السرية -->
    <div id="login-screen">
        <div class="login-card">
            <i class="fa-solid fa-heart-circle-bolt" style="font-size: 3.5rem; color: var(--primary); margin-bottom: 15px;"></i>
            <h1 class="love-title">بحب احمد 💖</h1>
            <p style="margin-bottom: 20px; color: #7a4253;">ادخلي الرمز السري لفتح برنامجكِ الخاص</p>
            <input type="password" id="pin-code" class="pin-input" placeholder="اكتبي: بحب احمد">
            <button onclick="checkPin()" class="login-btn">دخول لقلب أحمد 🔑</button>
            <p id="error-msg" style="color: #d9534f; margin-top: 10px; display: none; font-weight: bold;"></p>
        </div>
    </div>

    <!-- 2. شاشة المفاجأة -->
    <div id="surprise-screen">
        <div class="surprise-card">
            <h2 style="color: var(--primary); font-size: 2rem;">إلى أميرتي ودلوعتي بسملة 👑💖</h2>
            <div class="surprise-text">
                "عملتلك البرنامج ده مخصوص عشان يعيش معاكي كل لحظة في يومك، يشرحلك دروس الفرقة الأولى ويسهلها عليكي، يططب عليكِ لما تتعبي، ويدلعك زي ما أنتي متعودة من أحمد دايماً ✨"
            </div>
            <button onclick="openMainApp()" class="login-btn">دخول للبرنامج (دلوعة أحمد) 💖</button>
        </div>
    </div>

    <!-- 3. الواجهة الرئيسية -->
    <div id="app-container">
        <header>
            <div style="display: flex; align-items: center; gap: 10px;">
                <i class="fa-solid fa-crown" style="font-size: 2rem; color: var(--primary);"></i>
                <h1 style="color: var(--primary); font-size: 1.6rem;">دلوعة أحمد 💖</h1>
            </div>
        </header>

        <div class="tabs-nav">
            <button class="tab-btn active" onclick="switchTab(event, 'study-chat')"><i class="fa-solid fa-graduation-cap"></i> شات المذاكرة</button>
            <button class="tab-btn" onclick="switchTab(event, 'love-chat')"><i class="fa-solid fa-heart"></i> شات الدلع والفضفضة</button>
            <button class="tab-btn" onclick="switchTab(event, 'prayer-chat')"><i class="fa-solid fa-kaaba"></i> شات الصلاة</button>
            <button class="tab-btn" onclick="switchTab(event, 'organizer')"><i class="fa-solid fa-calendar-week"></i> الجدول</button>
            <button class="tab-btn" onclick="switchTab(event, 'period-tracker')"><i class="fa-solid fa-notes-medical"></i> متابع البيريود</button>
        </div>

        <!-- 1. شات المذاكرة -->
        <div id="study-chat" class="tab-content active">
            <div class="chat-wrapper">
                <div class="chat-messages" id="study-messages">
                    <div class="message bot">أهلاً يا أميرتي ودلوعة أحمد! 🎓 أنا دكتورة بوسي، اسأليني في أي مادة في الفرقة الأولى وهشرحهالك ببساطة ودلع 💕</div>
                </div>
                <div class="chat-input-area">
                    <input type="text" id="study-input" class="chat-input" placeholder="اسألي عن أي درس أو مادة..." onkeypress="handleEnter(event, 'study')">
                    <button class="send-btn" onclick="sendMessage('study')"><i class="fa-solid fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

        <!-- 2. شات الفضفضة -->
        <div id="love-chat" class="tab-content">
            <div class="chat-wrapper">
                <div class="chat-messages" id="love-messages">
                    <div class="message bot">يا روح قلب أحمد وسكرته! 💖 فضفضي وتدلعي براحتك، أحمد و بوسي معاكي ومفيش زعل أبداً.</div>
                </div>
                <div class="chat-input-area">
                    <input type="text" id="love-input" class="chat-input" placeholder="فضفضي وتدلعي براحتك..." onkeypress="handleEnter(event, 'love')">
                    <button class="send-btn" onclick="sendMessage('love')"><i class="fa-solid fa-heart"></i></button>
                </div>
            </div>
        </div>

        <!-- 3. شات الصلاة -->
        <div id="prayer-chat" class="tab-content">
            <div class="chat-wrapper">
                <div class="chat-messages" id="prayer-messages">
                    <div class="message bot">تقبل الله منكِ يا سكرتي 🕌 مساحتكِ الإيمانية للتذكير بالصلوات والدعاء.</div>
                </div>
                <div class="chat-input-area">
                    <input type="text" id="prayer-input" class="chat-input" placeholder="اطلبي دعاء أو أذكار..." onkeypress="handleEnter(event, 'prayer')">
                    <button class="send-btn" onclick="sendMessage('prayer')"><i class="fa-solid fa-hands-praying"></i></button>
                </div>
            </div>
        </div>

        <!-- 4. الجدول التنظيمي -->
        <div id="organizer" class="tab-content">
            <h2 style="color: var(--primary); margin-bottom: 15px;">الجدول اليومي لدلوعة أحمد 🌸</h2>
            <div class="grid-2">
                <div class="card-box">
                    <h3 style="color: var(--primary); margin-bottom: 10px;">متابع الصلوات</h3>
                    <div class="prayer-item"><span>الفجر</span><span class="prayer-status status-done" onclick="togglePrayer(this)">أُديت ✨</span></div>
                    <div class="prayer-item"><span>الظهر</span><span class="prayer-status status-done" onclick="togglePrayer(this)">أُديت ✨</span></div>
                    <div class="prayer-item"><span>العصر</span><span class="prayer-status status-pending" onclick="togglePrayer(this)">في الانتظار ⏳</span></div>
                    <div class="prayer-item"><span>المغرب</span><span class="prayer-status status-pending" onclick="togglePrayer(this)">في الانتظار ⏳</span></div>
                    <div class="prayer-item"><span>العشاء</span><span class="prayer-status status-pending" onclick="togglePrayer(this)">في الانتظار ⏳</span></div>
                </div>
                <div class="card-box">
                    <h3 style="color: var(--primary); margin-bottom: 10px;">توزيع الوقت</h3>
                    <p style="margin-bottom: 10px;">📖 <b>مذاكرة:</b> ساعتين صباحاً وساعتين عصراً</p>
                    <p style="margin-bottom: 10px;">🌸 <b>عناية وراحة:</b> بعد الظهر</p>
                    <p>💖 <b>دلع مع أحمد:</b> باقي اليوم!</p>
                </div>
            </div>
        </div>

        <!-- 5. متابع البيريود -->
        <div id="period-tracker" class="tab-content">
            <h2 style="color: var(--primary); margin-bottom: 15px;">متابع الدورة الشهرية والعناية الذاتية 🌸</h2>
            <div class="grid-2">
                <div class="card-box" style="text-align: center;">
                    <h3 style="color: var(--primary);">الموعد القادم المتوقع</h3>
                    <div style="font-size: 2.2rem; font-weight: 800; color: var(--primary); margin: 15px 0;">باقي 8 أيام</div>
                    <button class="login-btn" onclick="alert('تم حفظ البيانات يا سكرة!')">تحديث البيانات</button>
                </div>
                <div class="card-box">
                    <h3 style="color: var(--primary); margin-bottom: 10px;">نصائح أحمد لدلوعته</h3>
                    <p style="line-height: 1.8;">☕ اشربي مشروبات دافئة كالنعناع والقرفة.<br>🛌 مفيش أي ضغط دراسي وقت التعب.<br>💖 أحمد معاكي وبيرعاكي دايماً.</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // إعداد القلوب
        function createHearts() {
            const container = document.getElementById('hearts-container');
            for (let i = 0; i < 20; i++) {
                const heart = document.createElement('i');
                heart.className = 'fa-solid fa-heart heart-particle';
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.animationDuration = (Math.random() * 4 + 5) + 's';
                heart.style.fontSize = (Math.random() * 15 + 10) + 'px';
                container.appendChild(heart);
            }
        }
        createHearts();

        // فحص الرمز السري
        function checkPin() {
            const pin = document.getElementById('pin-code').value.trim();
            if (pin === "بحب احمد") {
                document.getElementById('login-screen').style.display = 'none';
                document.getElementById('surprise-screen').style.display = 'flex';
            } else {
                const err = document.getElementById('error-msg');
                err.style.display = 'block';
                err.innerText = 'الرمز خاطئ! اكتبي "بحب احمد" 💕';
            }
        }

        function openMainApp() {
            document.getElementById('surprise-screen').style.display = 'none';
            document.getElementById('app-container').style.display = 'block';
        }

        function switchTab(evt, tabId) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            evt.currentTarget.classList.add('active');
            document.getElementById(tabId).classList.add('active');
        }

        function togglePrayer(el) {
            if (el.classList.contains('status-done')) {
                el.className = 'prayer-status status-pending'; el.innerText = 'في الانتظار ⏳';
            } else if (el.classList.contains('status-pending')) {
                el.className = 'prayer-status status-exempt'; el.innerText = 'معفوة (بيريود) 🌸';
            } else {
                el.className = 'prayer-status status-done'; el.innerText = 'أُديت ✨';
            }
        }

        // الذكاء الاصطناعي والشرح الحقيقي
        async function fetchGeminiResponse(promptText, type) {
            let systemInstruction = "";
            if (type === 'study') {
                systemInstruction = "أنتِ 'دكتورة بوسي' المساعد التعليمي لدلوعة أحمد 'بسملة'. اشرحي لها مواد الفرقة الأولى (إدارة أعمال، محاسبة، اقتصاد، تكنولوجيا) بأسلوب مبسط جداً وممتع ومصحوب بالحب والدلع والتشجيع المباشر باسمها وبحب أحمد لها.";
            } else if (type === 'love') {
                systemInstruction = "أنتِ 'بوسي بسملة' تعبرين عن روح أحمد. قدمي لبسملة أعلى درجات الطبطبة، الدعم العاطفي، التدليل، والدلع بكلمات مفعمة بالحب والحنان.";
            } else {
                systemInstruction = "أنتِ المساعد الإيماني الدافئ لبسملة (دلوعة أحمد). ذكّريها بالصلوات والأذكار بأسلوب إيماني حنون ومحبب يشجعها على الطاعة.";
            }

            try {
                const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=YOUR_GEMINI_API_KEY`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ role: 'user', parts: [{ text: promptText }] }],
                        systemInstruction: { parts: [{ text: systemInstruction }] }
                    })
                });
                const data = await res.json();
                if (data.candidates && data.candidates[0].content.parts[0].text) {
                    return data.candidates[0].content.parts[0].text;
                }
            } catch (e) {
                console.log(e);
            }

            // الرد البديل التلقائي المزين
            if (type === 'study') {
                return `من عيوني يا دلوعة أحمد! 🎓 بخصوص "${promptText}": المادة دي سهلة جداً، الفكرة الأساسية فيها بتعتمد على الفهم وربط المفاهيم بالتطبيق العملي. أحمد فخور بيكي وواثق إنك أشطر بنوتة في الفرقة الأولى 💕`;
            } else if (type === 'love') {
                return `يا روح قلب أحمد وسكرته! 💖 أحمد بيبعتلك ألف بوسة وبيقولك أنتي أجمل وأرقى بنوتة في الدنيا، ومفيش أي حاجة تستاهل زعلك أو تعبك خالص ✨`;
            } else {
                return `تقبل الله من دلوعة أحمد العفيفة 🌸 ربنا يتقبل منكِ صلاتك ويحفظك لأحمد ويبارك في قلبكِ الطاهر الجميل ✨`;
            }
        }

        async function sendMessage(type) {
            const input = document.getElementById(`${type}-input`);
            const text = input.value.trim();
            if (!text) return;

            const container = document.getElementById(`${type}-messages`);
            
            // إضافة رسالة بسملة
            const userDiv = document.createElement('div');
            userDiv.className = 'message user';
            userDiv.innerText = text;
            container.appendChild(userDiv);

            input.value = '';
            container.scrollTop = container.scrollHeight;

            // إضافة مؤشر جاري الكتابة
            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'message bot';
            loadingDiv.innerText = 'بوسي بتكتبلك بحب... 💖';
            container.appendChild(loadingDiv);
            container.scrollTop = container.scrollHeight;

            // جلب الإجابة الشارحة
            const reply = await fetchGeminiResponse(text, type);
            loadingDiv.innerText = reply;
            container.scrollTop = container.scrollHeight;
        }

        function handleEnter(e, type) {
            if (e.key === 'Enter') sendMessage(type);
        }
    </script>
</body>
</html>
